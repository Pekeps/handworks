{
  "name": "handworks",
  "version": "0.1.0",
  "description": "Anatomically grounded 3D hand posing and animation for the web — shadow figures, ASL fingerspelling, and full per-joint control.",
  "license": "MIT",
  "type": "module",
  "author": "Pekeps",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pekeps/handworks.git"
  },
  "keywords": [
    "hand",
    "3d",
    "three",
    "threejs",
    "animation",
    "sign-language",
    "asl",
    "fingerspelling",
    "shadow-puppet",
    "webxr"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "default": "./dist/three/index.js"
    },
    "./assets/*": "./dist/assets/*"
  },
  "scripts": {
    "dev": "vite examples",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "build:examples": "vite build examples",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "three": ">=0.150.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/three": "^0.178.0",
    "puppeteer-core": "^25.5.0",
    "three": "^0.178.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
