{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "noEmit": true,
    "paths": {
      "handworks": ["./src/index.ts"],
      "handworks/core": ["./src/core/index.ts"],
      "handworks/three": ["./src/three/index.ts"]
    }
  },
  "include": ["src", "test", "examples/**/*.ts"]
}
